# Copie este arquivo para .env e preencha os valores.
# Gere uma SECRET_KEY nova com:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

SECRET_KEY=coloque-uma-chave-secreta-aqui
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL (o docker-compose ja sobe um banco com estes valores)
POSTGRES_DB=biblioteca
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=biblioteca
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Deixe True para rodar com SQLite, sem precisar de PostgreSQL
USE_SQLITE=False
